[gd_scene format=3]

[ext_resource type="Script" path="res://room.gd" id="1_room"]
[ext_resource type="PackedScene" path="res://lab_room.tscn" id="2_lab"]
[ext_resource type="PackedScene" path="res://gate.tscn" id="3_gate"]
[ext_resource type="PackedScene" path="res://door.tscn" id="4_door"]

[node name="Room2" type="Node3D"]
script = ExtResource("1_room")

[node name="LabRoom" parent="." instance=ExtResource("2_lab")]
title = "ROOM 2: THE AND GATE"
instructions = "An AND gate needs BOTH inputs ON.
A OFF, B OFF  ->  light OFF
A ON,  B OFF  ->  light OFF
A OFF, B ON   ->  light OFF
A ON,  B ON   ->  light ON

Turn the light ON to escape."

[node name="Gate" parent="." instance=ExtResource("3_gate")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.05, -0.8)
gate_type = 0

[node name="Door" parent="." instance=ExtResource("4_door")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -2.66)
